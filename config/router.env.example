# Upstream interface. Default topology uses Ethernet for WAN.
WAN_IFACE="eth0"

# Wireless interface used by hostapd for the local access point.
AP_IFACE="wlan0"

# Private AP network. Do not overlap with the WAN network or tailnet routes.
AP_ADDRESS="192.168.50.1"
AP_CIDR="24"
DHCP_START="192.168.50.20"
DHCP_END="192.168.50.200"
DHCP_LEASE="12h"

# Wi-Fi settings. Change the passphrase before installing.
WIFI_SSID="Pi-Travel"
WIFI_PASSPHRASE="CHANGE-ME-TO-A-LONG-RANDOM-PASSWORD"
WIFI_COUNTRY="PK"
WIFI_CHANNEL="6"
WIFI_HW_MODE="g"

# dnsmasq upstream resolver.
DNS_UPSTREAM="1.1.1.1"
